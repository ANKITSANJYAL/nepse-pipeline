# All optional - defaults are in src/nepse_pipeline/config.py
NEPSE_BASE_URL=https://www.nepalstock.com.np
NEPSE_DATA_ROOT=./data
NEPSE_POLL_INTERVAL=20      # backend refreshes ~24s; faster buys nothing
NEPSE_TIMEOUT=45
NEPSE_MAX_RETRIES=5
NEPSE_MIN_GAP=0.7           # seconds between requests
NEPSE_PAGE_SIZE=500         # server caps at 500
